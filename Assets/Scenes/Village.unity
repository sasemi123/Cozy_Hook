      propertyPath: 'callouts.Array.data[0]'
      value: "\u0E1B\u0E25\u0E32\u0E2A\u0E14\u0E08\u0E49\u0E32 \u0E1B\u0E25\u0E32\u0E2A\u0E14!"
      objectReference: {fileID: 0}
    - target: {fileID: 8525190764582159445, guid: c5a4fc875c630cc4ea7448f96863d94b, type: 3}
      propertyPath: 'callouts.Array.data[1]'
      value: "\u0E23\u0E31\u0E1A\u0E0B\u0E37\u0E49\u0E2D\u0E1B\u0E25\u0E32\u0E23\u0E32\u0E04\u0E32\u0E14\u0E35\u0E08\u0E49\u0E32!"
      objectReference: {fileID: 0}
    - target: {fileID: 8525190764582159445, guid: c5a4fc875c630cc4ea7448f96863d94b, type: 3}
      propertyPath: 'callouts.Array.data[2]'
      value: "\u0E41\u0E27\u0E30\u0E21\u0E32\u0E01\u0E48\u0E2D\u0E19\u0E08\u0E49\u0E32 \u0E27\u0E31\u0E19\u0E19\u0E35\u0E49\u0E1B\u0E25\u0E32\u0E15\u0E31\u0E27\u0E42\u0E15!"
      objectReference: {fileID: 0}
    - target: {fileID: 8525190764582159445, guid: c5a4fc875c630cc4ea7448f96863d94b, type: 3}
      propertyPath: 'callouts.Array.data[3]'
      value: "\u0E43\u0E04\u0E23\u0E15\u0E01\u0E1B\u0E25\u0E32\u0E44\u0E14\u0E49 \u0E40\u0E2D\u0E32\u0E21\u0E32\u0E02\u0E32\u0E22\u0E25\u0E38\u0E07\u0E44\u0E14\u0E49\u0E19\u0E30!"
      objectReference: {fileID: 0}
    - target: {fileID: 8525190764582159445, guid: c5a4fc875c630cc4ea7448f96863d94b, type: 3}
      propertyPath: 'greetings.Array.data[0]'
      value: "\u0E21\u0E32\u0E41\u0E25\u0E49\u0E27\u0E40\u0E2B\u0E23\u0E2D! \u0E27\u0E31\u0E19\u0E19\u0E35\u0E49\u0E44\u0E14\u0E49\u0E1B\u0E25\u0E32\u0E2D\u0E30\u0E44\u0E23\u0E21\u0E32\u0E02\u0E32\u0E22\u0E1A\u0E49\u0E32\u0E07?"
      objectReference: {fileID: 0}
    - target: {fileID: 8525190764582159445, guid: c5a4fc875c630cc4ea7448f96863d94b, type: 3}
      propertyPath: 'greetings.Array.data[1]'
      value: "\u0E1B\u0E25\u0E32\u0E2A\u0E14\u0E46 \u0E08\u0E32\u0E01\u0E17\u0E30\u0E40\u0E25\u0E2A\u0E32\u0E1A\u0E08\u0E49\u0E32 \u0E0B\u0E37\u0E49\u0E2D\u0E01\u0E47\u0E44\u0E14\u0E49 \u0E02\u0E32\u0E22\u0E01\u0E47\u0E14\u0E35"
      objectReference: {fileID: 0}
    - target: {fileID: 8525190764582159445, guid: c5a4fc875c630cc4ea7448f96863d94b, type: 3}
      propertyPath: 'greetings.Array.data[2]'
      value: "\u0E2D\u0E22\u0E48\u0E32\u0E25\u0E37\u0E21\u0E44\u0E1B\u0E14\u0E39\u0E23\u0E32\u0E04\u0E32\u0E17\u0E35\u0E48\u0E1B\u0E49\u0E32\u0E22\u0E1B\u0E23\u0E30\u0E01\u0E32\u0E28\u0E01\u0E48\u0E2D\u0E19\u0E19\u0E30 \u0E25\u0E38\u0E07\u0E44\u0E21\u0E48\u0E1A\u0E2D\u0E01\u0E2B\u0E23\u0E2D\u0E01 \u0E2E\u0E48\u0E32\u0E46"
